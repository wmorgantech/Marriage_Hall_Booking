# Root .env — values shared by both apps (apps/* also have their own .env.example)
# Copy to .env and fill in.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/checknbook?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"

# API
API_PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Web
VITE_API_BASE_URL="http://localhost:4000"
