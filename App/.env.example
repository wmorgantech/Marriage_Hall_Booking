# EXPO_PUBLIC_API_BASE_URL decides which server the app calls.
#
#   .env                    – copy this file to .env; used by EVERY build, including production-style ones.
#   .env.development.local  – git-ignored; applies only to `expo start` and overrides .env, so local runs
#                             never hit a remote server. Leave the value empty to use the built-in local
#                             default (Android emulator 10.0.2.2:4000, iOS simulator / web localhost:4000),
#                             or put your computer's LAN address for a physical phone.
EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.example
