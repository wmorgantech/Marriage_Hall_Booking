# Copy to .env (and .env.development) and fill in. Never commit real values.
# URL-encode special characters in the password (e.g. "@" -> "%40").
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/checknbook?schema=public"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Operator console accounts (pnpm seed:admins) and demo owners (pnpm seed).
# Min 12 chars; there are no built-in default passwords.
SEED_ADMIN_PASSWORD=""
SEED_SUPERADMIN_PASSWORD=""
SEED_OWNER_PASSWORD=""
