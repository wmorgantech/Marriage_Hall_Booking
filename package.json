{
  "name": "checknbook",
  "version": "0.1.0",
  "private": true,
  "description": "CheckNBook monorepo — backend (Express + Prisma) + frontend (React + Vite) + packages/types",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @checknbook/api dev\" \"pnpm --filter @checknbook/web dev\"",
    "dev:api": "pnpm --filter @checknbook/api dev",
    "dev:web": "pnpm --filter @checknbook/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "prisma:migrate": "pnpm --filter @checknbook/api prisma:migrate",
    "prisma:studio": "pnpm --filter @checknbook/api prisma:studio",
    "seed": "pnpm --filter @checknbook/api seed",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:reset": "docker compose -f infra/docker-compose.yml down -v"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
